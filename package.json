{
  "name": "tcf-canada-french",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 4173 --bind 127.0.0.1",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/check.mjs && node scripts/check-auth.mjs && node scripts/check-google-auth.mjs",
    "build:hosted": "node scripts/build-hosted.mjs",
    "start": "node server/server.mjs",
    "test:students": "node scripts/check-student-auth.mjs",
    "test:essay-ai": "node scripts/check-essay-assessment.mjs && node scripts/check-writing-submissions.mjs",
    "test:codex-review": "node scripts/check-codex-review.mjs && node scripts/check-writing-submissions.mjs",
    "test:dashboard": "node scripts/check-learning-dashboard.mjs",
    "test:pronunciation": "node scripts/check-pronunciation.mjs && node scripts/check-human-audio.mjs && node scripts/check-phonics-separation.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jose": "^6.2.15"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "packageManager": "pnpm@11.25.0"
}
