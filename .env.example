# AI 作文评估为可选服务端功能；没有 OPENAI_API_KEY 时不启用。
# 后续服务端密钥不得加 VITE_ 前缀或进入前端构建。
# Current mode: no login required
AUTH_PROVIDER=none
# Optional Google login (not enabled)
# AUTH_PROVIDER=google
# GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# GOOGLE_SESSION_SECRET=GENERATE_A_RANDOM_32_BYTE_BASE64URL_VALUE

# Optional OpenAI essay assessment — set secret values in Render, never in Git.
# OPENAI_API_KEY=add_your_project_secret_in_render
# OPENAI_REVIEW_MODEL=gpt-5.4-mini
# AI_REVIEW_MONTHLY_LIMIT=50
# AI_REVIEW_ENABLED=false
